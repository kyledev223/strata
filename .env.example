# Which cluster: "devnet" (default), "mainnet-beta" or "localnet".
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# RPC endpoint for the wallet adapter and the data source. Defaults to the cluster's
# public endpoint, which rate-limits (and often refuses the holder-count scans): use a
# paid one (Helius, Triton, QuickNode) for anything public.
NEXT_PUBLIC_SOLANA_RPC=
# "mock" (sample data) or "rpc" (read the strata program on the cluster above).
NEXT_PUBLIC_STRATA_DATA=mock
# "true" once the program is deployed on the cluster above: actions send real transactions.
# While false, or while data is "mock", every page shows a preview notice and is noindex.
NEXT_PUBLIC_PROGRAMS_LIVE=false
# Public URL of the site, used for share cards, the sitemap and robots.txt.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://strata.example
# Optional. When set, every page asks for this password (any username). Server-only.
PREVIEW_PASSWORD=
# Optional. Pinata JWT for token picture + metadata uploads (server-only). Without it,
# launches go out with a generated picture and no off-chain description.
PINATA_JWT=
# Optional. Your Pinata gateway, e.g. https://your-name.mypinata.cloud
PINATA_GATEWAY=
