# RPC endpoint used by the wallet adapter and (later) the RPC data source.
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
# "mock" (default) or "rpc". The rpc source is stubbed until the Anchor programs ship.
NEXT_PUBLIC_STRATA_DATA=mock
# "true" once the programs are deployed and lib/strata/actions.ts sends real transactions.
# While false (or the data source is "mock"), every page shows a preview notice.
NEXT_PUBLIC_PROGRAMS_LIVE=false
